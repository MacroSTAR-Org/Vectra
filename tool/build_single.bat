    echo          2. Add Folder Recursive ??? %RELEASE%
    echo          3. Options - File Options ??? Compress files
    echo          4. ????? %EVB_PROJ%
    exit /b 1
)

rem ---- ???? release ----
if /i not "%~1"=="--skip" (
    echo [1/3] flutter build windows --release ...
    pushd "%ROOT%"
    call flutter build windows --release --no-pub
    if errorlevel 1 (
        echo [????] flutter build ???
        popd
        exit /b 1
    )
    popd
) else (
    echo [1/3] ??????????--skip??
)

rem ---- ?????? ----
if not exist "%RELEASE%\vectra.exe" (
    echo [????] ????? %RELEASE%\vectra.exe
    exit /b 1
)

rem ---- ??? ----
if not exist "%OUT_DIR%" mkdir "%OUT_DIR%"

echo [2/3] Enigma Virtual Box ????? ...
"%EVB%" "%EVB_PROJ%" /o "%OUT_EXE%"
if errorlevel 1 (
    echo [????] ??????
    exit /b 1
)

echo [3/3] ????%OUT_EXE%
