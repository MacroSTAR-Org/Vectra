setlocal

rem ---- ��?? ----
set "ROOT=%~dp0.."
set "RELEASE=%ROOT%\build\windows\x64\runner\Release"
set "EVB_PROJ=%~dp0single_file.evb"
set "OUT_DIR=%ROOT%\installer\out"

rem ---- read version from pubspec.yaml (single source of truth) ----
set "PUBSPEC_VERSION="
for /f "tokens=2 delims= " %%v in ('findstr /b /c:"version:" "%ROOT%\pubspec.yaml"') do (
    if not defined PUBSPEC_VERSION set "PUBSPEC_VERSION=%%v"
)
set "APP_VERSION=%PUBSPEC_VERSION:+=.%"

set "OUT_EXE=%OUT_DIR%\Vectra-%APP_VERSION%-???????.exe"

rem ---- ?? Enigma ?????��??? ----
set "EVB="
if exist "C:\Program Files\Enigma Virtual Box\enigmavbconsole.exe" set "EVB=C:\Program Files\Enigma Virtual Box\enigmavbconsole.exe"
if exist "C:\Program Files (x86)\Enigma Virtual Box\enigmavbconsole.exe" set "EVB=C:\Program Files (x86)\Enigma Virtual Box\enigmavbconsole.exe"

if not defined EVB (
    echo [????] ????? enigmavbconsole.exe??
    echo        ?????? Enigma Virtual Box??https://www.enigmavb.com/
    exit /b 1
)

if not exist "%EVB_PROJ%" (
    echo [????] ??????????? %EVB_PROJ%
    echo        ???? Enigma Virtual Box GUI ??????��?
