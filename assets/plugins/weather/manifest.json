{
  "id": "weather",
  "name": "天气",
  "version": "2.0.0",
  "entry": "index.js",
  "description": "Open-Meteo，无需 API key",
  "icon": "☀",
  "sizes": ["3x2", "3x3", "4x2", "4x3"],
